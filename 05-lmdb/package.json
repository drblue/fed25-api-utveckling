{
  "name": "05-lmdb",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "env-cmd --silent bash scripts/build.sh",
    "build-app": "npm run lint && npm run typecheck && node scripts/build.js",
    "check": "run-s lint typecheck type-coverage",
    "debug": "cross-env DEBUG=lmdb:* tsx --watch src/server.ts",
    "dev": "cross-env DEBUG=lmdb:* tsx --watch src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "type-coverage": "type-coverage -p tsconfig.json --at-least 99 --detail",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "Johan Nordström <johan@digitalvillage.se>",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "debug": "^4.4.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.3",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "tsx": "^4.21.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
