generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Author {
  id    Int    @id @default(autoincrement()) @db.UnsignedInt
  name  String
  books Book[]
}

model Book {
  id      Int      @id @default(autoincrement()) @db.UnsignedInt
  title   String
  pages   Int      @db.UnsignedInt
  authors Author[]
}
